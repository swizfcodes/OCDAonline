# --- Database (MySQL) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Security ---
# Long random strings. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional. If blank, a value derived from JWT_SECRET is used.
SESSION_SECRET=

# --- Server ---
PORT=5500
NODE_ENV=production
# Optional. Comma-separated list of sites allowed to call the API from a browser.
ALLOWED_ORIGINS=https://oyinakokocda.org,https://www.oyinakokocda.org
